generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String
  password   String
  created_at DateTime? @default(now())
  update_at  DateTime? @default(now())
  roles_id   String
  roles      Role      @relation(fields: [roles_id], references: [id])

  @@map("users")
}

model Category {
  id         String    @id @default(uuid())
  name       String
  created_at DateTime? @default(now())
  update_at  DateTime? @default(now())
  products   Product[]

  @@map("categories")
}

model Product {
  id                 String               @id @default(uuid())
  name               String
  price              String
  description        String
  banner             String
  created_at         DateTime?            @default(now())
  update_at          DateTime?            @default(now())
  category_id        String
  productIngrediente ProdutoIngrediente[]
  items              Item[]
  category           Category             @relation(fields: [category_id], references: [id])

  @@map("products")
}

model Item {
  id              String            @id @default(uuid())
  amount          Int
  created_at      DateTime?         @default(now())
  update_at       DateTime?         @default(now())
  order_id        String
  product_id      String
  ItemAdicional   ItemAdicional[]
  ItemIngrediente ItemIngrediente[]
  order           Order             @relation(fields: [order_id], references: [id])
  product         Product           @relation(fields: [product_id], references: [id])

  @@map("items")
}

model Table {
  id     Int     @id @default(autoincrement())
  number Int     @unique
  orders Order[]

  @@map("tables")
}

model Order {
  id         String      @id @default(uuid())
  draft      Boolean     @default(true)
  name       String?
  created_at DateTime?   @default(now())
  update_at  DateTime?   @default(now())
  tableId    Int
  status     Int         @default(0)
  comanda    Comanda[]
  feedback   Feedback[]
  items      Item[]
  table      Table       @relation(fields: [tableId], references: [id])
  pagamento  Pagamento[]

  @@map("orders")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]

  @@map("roles")
}

model adicionais {
  id            String          @id @default(uuid())
  created_at    DateTime?       @default(now())
  update_at     DateTime?       @default(now())
  name          String
  price         Float
  ItemAdicional ItemAdicional[]
}

model ingredientes {
  id                 String               @id @default(uuid())
  name               String               @unique
  productIngrediente ProdutoIngrediente[]
  ItemIngrediente    ItemIngrediente[]

  @@map("ingredientes")
}

model Pagamento {
  id         String    @id @default(uuid())
  order_id   String
  amount     Float
  status     Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  metodo     Int
  comanda    Comanda[]
  order      Order     @relation(fields: [order_id], references: [id])

  @@map("pagamento")
}

model Comanda {
  id           String    @id @default(uuid())
  order_id     String
  amount       Float
  pagamento_id String
  created_at   DateTime? @default(now())
  update_at    DateTime? @default(now())
  order        Order     @relation(fields: [order_id], references: [id])
  pagamento    Pagamento @relation(fields: [pagamento_id], references: [id])

  @@map("comanda")
}

model ProdutoIngrediente {
  id            String       @id @default(uuid())
  produtoId     String
  ingredienteId String
  ingrediente   ingredientes @relation(fields: [ingredienteId], references: [id])
  product       Product      @relation(fields: [produtoId], references: [id])

  @@unique([produtoId, ingredienteId])
}

model Feedback {
  id         String    @id @default(uuid())
  comment    String
  rating     Int
  order_id   String
  created_at DateTime? @default(now())
  update_at  DateTime? @default(now())
  order      Order     @relation(fields: [order_id], references: [id])

  @@map("feedbacks")
}

model ItemAdicional {
  id          String     @id
  itemId      String
  adicionalId String
  created_at  DateTime?  @default(now())
  update_at   DateTime?  @default(now())
  quantity    Int
  adicionais  adicionais @relation(fields: [adicionalId], references: [id])
  items       Item       @relation(fields: [itemId], references: [id])

  @@unique([itemId, adicionalId])
}

model ItemIngrediente {
  id            String       @id @default(uuid())
  itemId        String
  ingredienteId String
  removed       Boolean      @default(false)
  created_at    DateTime?    @default(now())
  update_at     DateTime?    @default(now())
  ingrediente   ingredientes @relation(fields: [ingredienteId], references: [id])
  item          Item         @relation(fields: [itemId], references: [id])

  @@unique([itemId, ingredienteId])
}
